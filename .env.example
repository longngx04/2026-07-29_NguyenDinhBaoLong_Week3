# Sao chép thành .env rồi điền. KHÔNG BAO GIỜ commit .env.

LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Model này là model đã sinh ra mọi số liệu trong reports/week-06/.
# Đổi model thì số liệu chất lượng Agent không còn tái lập được — kết quả
# dao động ngay cả khi giữ nguyên model, xem docs/limitations.md §1.1.
LLM_MODEL=qwen/qwen3-235b-a22b-2507

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Số nhóm finding được phân tích đồng thời. Đây là thứ quyết định bước analyze
# mất bao lâu — các nhóm độc lập nhau và kết quả được ráp lại đúng thứ tự đầu
# vào, nên con số này chỉ đổi thời gian chạy, không đổi kết quả.
#
# Đo trên cùng 37 finding, cùng model:
#   LLM_CONCURRENCY=4   →  344-415 giây
#   LLM_CONCURRENCY=12  →  165 giây
#   LLM_CONCURRENCY=40  →  108 giây
# Không lần nào gặp lỗi 429. Độ trễ mỗi lời gọi tăng dần theo mức song song
# (34 giây ở mức 4, 54 giây ở mức 40) nên đẩy cao hơn nữa lãi ít dần.
# Hạ xuống nếu tài khoản OpenRouter của bạn có hạn mức chặt hơn.
LLM_CONCURRENCY=40

# Số lần thử lại RIÊNG cho lỗi 429, tách khỏi LLM_MAX_RETRIES ở trên.
# Chạy 40 luồng thì bị giới hạn tốc độ là chuyện thường, còn LLM_MAX_RETRIES
# được đặt cho lỗi mạng — dùng chung một ngân sách nghĩa là một lần 429 làm
# mất một finding. Backoff theo hàm mũ có jitter, và tôn trọng Retry-After.
LLM_RATE_LIMIT_MAX_RETRIES=4

# Sinh bằng: openssl rand -hex 32
SENTINEL_GATEWAY_API_KEY=
